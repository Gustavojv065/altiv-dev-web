# ALTIV DEV — server-side provider configuration
# Never expose provider, GitHub or Supabase service-role secrets in NEXT_PUBLIC_* variables.

# Optional Vercel AI Gateway fallback
AI_GATEWAY_API_KEY=

# AI providers — configure one or many. The router uses available providers automatically.
# Free-first option: OpenRouter Free Models Router (openrouter/free)
OPENROUTER_API_KEY=

# OpenCode Zen — supports curated coding models and free models when available
OPENCODE_ZEN_API_KEY=

# Paid/BYOK providers
OPENAI_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# Optional model overrides
OPENAI_CODE_MODEL=gpt-5.6-sol
GEMINI_CODE_MODEL=gemini-3.1-pro-preview
GEMINI_DESIGN_MODEL=gemini-3.1-pro-preview
GEMINI_VISION_MODEL=gemini-3.1-pro-preview
GEMINI_FAST_MODEL=gemini-3.1-flash

# Public app URL used only for OpenRouter attribution headers
NEXT_PUBLIC_APP_URL=

# Supabase - publishable values only in NEXT_PUBLIC_ vars
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub App/API - server side only
# Prefer GitHub App/OAuth for commercial use; PAT remains a development fallback.
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=

# Optional execution/sandbox layer
E2B_API_KEY=

# 32 random bytes encoded as base64; used to encrypt customer BYOK credentials
ALTIV_SECRET_ENCRYPTION_KEY=

# SaaS super-admin bootstrap. Prefer assigning profiles.role=super_admin after initial setup.
ALTIV_SUPER_ADMIN_EMAILS=
ALTIV_SUPER_ADMIN_IDS=

# Billing providers (server side only)
MERCADO_PAGO_ACCESS_TOKEN=
STRIPE_SECRET_KEY=
